{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${INTERLOCK_HOME:-$CLAUDE_PROJECT_DIR}/bin/interlock.js\" hook SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${INTERLOCK_HOME:-$CLAUDE_PROJECT_DIR}/bin/interlock.js\" hook UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${INTERLOCK_HOME:-$CLAUDE_PROJECT_DIR}/bin/interlock.js\" hook PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${INTERLOCK_HOME:-$CLAUDE_PROJECT_DIR}/bin/interlock.js\" hook PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${INTERLOCK_HOME:-$CLAUDE_PROJECT_DIR}/bin/interlock.js\" hook Stop",
            "timeout": 5
          }
        ]
      }
